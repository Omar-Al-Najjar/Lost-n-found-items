{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "AI App (Streamlit)",
      "type": "python",
      "request": "launch",
      "module": "streamlit",
      "args": [
        "run",
        "ai/app.py"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "env": {
        "KIMI_MODEL": "kimi-k2.5",
        "EMBEDDING_MODEL": "sentence-transformers/all-MiniLM-L6-v2",
        "MOONSHOT_BASE_URL": "https://api.moonshot.ai/v1"
      }
    }
  ]
}
